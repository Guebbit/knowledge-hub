# 2brain scope — which files 2brain documents.
#
# Gitignore-style patterns, one per line, matched against repo-relative paths:
#   src/**            every file under src/
#   **/*.test.ts      every .test.ts file, anywhere
#   docs/**           the whole docs tree
#
# [include] restricts the documented set. Empty = every file.
# [exclude] removes files from that set. Empty = nothing. Exclude wins.
#
# Regenerate the prompt that wrote this with: 2brain <repo> --rescope

[include]

[exclude]
# Planning prose *about* 2brain, not documentation *of* it. Any file here
# would otherwise get an llm-wiki page and enter the semantic corpus, where it
# competes with — and has outranked — the implementation pages for the very
# code the plan describes. Kept as standing policy: the directory is empty
# today, and this is what makes it safe to fill again.
docs/plans/**
