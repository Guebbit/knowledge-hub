FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg git curl ca-certificates gnupg \
    && rm -rf /var/lib/apt/lists/*

# Node.js 22 (NodeSource). Debian's own nodejs is too old for the GitHub Copilot
# CLI (needs Node 22+); this single Node also serves @anthropic-ai/claude-code and
# CodeBoarding's language servers. NodeSource's package bundles npm.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Subscription-backed CLIs — both let a preset use an existing subscription login
# instead of a metered API key:
#   • @anthropic-ai/claude-code → backs graphify's "claude-cli" backend
#     (a claude-code:* preset). Auth = host ~/.claude bind-mounted read-only.
#   • @github/copilot           → backs the "copilot-cli" provider (a copilot-cli:*
#     preset for wiki/query/2brain, i.e. the call_llm path). Auth = a fine-grained
#     PAT with "Copilot Requests", passed as COPILOT_GITHUB_TOKEN (see .env-example).
RUN npm install -g @anthropic-ai/claude-code @github/copilot

RUN pip install --no-cache-dir \
    requests \
    python-dotenv \
    anthropic \
    openai \
    faster-whisper \
    pypdf \
    beautifulsoup4 \
    pathspec \
    graphifyy==0.9.13

# CodeBoarding — backs the `2repo arch` layer (component docs + Mermaid diagrams).
# Never phone home: 2repo is local-first, so disable CodeBoarding telemetry for
# every invocation, including the build-time setup below (repo/arch.py also sets
# these per-subprocess as defence in depth).
ENV CODEBOARDING_TELEMETRY=false \
    DO_NOT_TRACK=1
# Installed in an isolated venv so its pinned dependencies can't conflict with the
# scripts' own (openai/anthropic/requests/graphify); 2repo only ever calls the
# `codeboarding` CLI as a subprocess. `codeboarding-setup` bakes the language-server
# binaries into ~/.codeboarding/servers at build time so no per-run download is
# needed (2repo invokes ephemeral `run --rm` containers). Node.js above satisfies
# the Python/TS/JS/PHP language servers. This version renders Markdown via the
# render_docs() Python API (repo/arch.py drives it in this venv), not a CLI flag.
RUN python -m venv /opt/codeboarding \
    && /opt/codeboarding/bin/pip install --no-cache-dir \
        codeboarding --extra-index-url https://pip.codeboarding.org/simple/ \
    && ln -s /opt/codeboarding/bin/codeboarding /usr/local/bin/codeboarding \
    && ln -s /opt/codeboarding/bin/codeboarding-setup /usr/local/bin/codeboarding-setup \
    && codeboarding-setup
